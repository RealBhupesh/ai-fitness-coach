# Local development: PostgreSQL + Better Auth. Demo must be explicitly enabled.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fitcoach
BETTER_AUTH_SECRET=replace-with-a-random-development-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
ENABLE_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
# Set only for local Docker PostgreSQL without TLS.
DATABASE_SSL=
DATABASE_SSL_CA=

# Production: all these services and HTTPS origins are required.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
BETA_ACCOUNT_LIMIT=50
# Open only after application release gates pass; existing mapped users can still sign in.
BETA_SIGNUPS_OPEN=false
# Set true only after inventory + backup of the existing deployment.
AUTH_MIGRATION_INVENTORIED=false
# Enable only for the controlled migration period; registration is disabled in production.
ENABLE_LEGACY_AUTH=false
NEXT_PUBLIC_ENABLE_LEGACY_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional AI services. Immediate movement cues remain local.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_TOKEN_BUDGET=200000
# disabled | shadow | live. Live also requires artifact/device evidence gates.
NEXT_PUBLIC_LEARNED_POSTURE_MODE=disabled

# Operator-only tools. Never commit populated values.
INVENTORY_DATABASE_URL=
TEST_DATABASE_URL=
RESTORE_DATABASE_URL=
# Random 32-byte key encoded as base64; store independently from backups.
BACKUP_ENCRYPTION_KEY=

NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_PAYMENTS=false
